{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis.local/tra/schema/tra-project.schema.json",
  "title": "TRA Project Manifest",
  "description": "Top-level manifest for a Threat and Risk Assessment project. References the artifacts produced by each step.",
  "type": "object",
  "required": [
    "traVersion",
    "device",
    "steps"
  ],
  "properties": {
    "traVersion": {
      "type": "string",
      "description": "Version of the TRA methodology this project follows."
    },
    "projectId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "device": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "e.g. radar level sensor, PLC, gateway"
        },
        "modelReference": {
          "type": "string",
          "description": "Comparable commercial device, illustrative only."
        },
        "purdueLevel": {
          "type": "string",
          "enum": [
            "0",
            "0-1",
            "1",
            "1-2",
            "2",
            "3"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "blackbox",
            "graybox",
            "whitebox"
          ],
          "description": "Configurable internal-modeling depth (FR-01)."
        },
        "boundary": {
          "type": "string"
        },
        "inScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "productContext": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        },
        "users": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "vulnerableGroups": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "title",
              "ref"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "ref": {
                "type": "string",
                "maxLength": 2000
              },
              "clause": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "riskCriteria": {
      "type": "object",
      "properties": {
        "schemeJustification": {
          "type": "string",
          "maxLength": 2000
        },
        "schemeSource": {
          "type": "string",
          "maxLength": 200
        },
        "inputs": {
          "type": "object",
          "properties": {
            "regulation": {
              "type": "string",
              "maxLength": 200
            },
            "contracts": {
              "type": "string",
              "maxLength": 200
            },
            "riskNature": {
              "type": "string",
              "maxLength": 200
            },
            "users": {
              "type": "string",
              "maxLength": 200
            },
            "productType": {
              "type": "string",
              "maxLength": 200
            },
            "stateOfTheArt": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "slTarget": {
      "type": "string",
      "description": "Target IEC 62443-4-2 Security Level (SL-C), e.g. SL2."
    },
    "riskSchemeId": {
      "type": "string",
      "description": "ID of the active risk scheme; built-in IDs are builtin:5x5-exposure and builtin:5x5-cost."
    },
    "riskSchemeFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 fingerprint of the normalized active risk scheme."
    },
    "acceptableLevel": {
      "type": "string",
      "description": "Maximum acceptable risk classification level ID in the active scheme."
    },
    "steps": {
      "type": "object",
      "description": "Relative paths to the artifact files produced by each step.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "review",
        "released"
      ]
    }
  }
}