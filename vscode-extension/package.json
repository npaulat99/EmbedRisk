{
  "name": "embedrisk",
  "displayName": "EmbedRisk — Threat & Risk Assessment",
  "description": "Guided Threat & Risk Assessment for embedded OT field devices: a layered DFD editor, STRIDE threats, attack-defence trees and reports. The VS Code companion to the EmbedRisk web app (shared JSON project format).",
  "version": "0.3.4",
  "publisher": "npaulat",
  "repository": {
    "type": "git",
    "url": "https://github.com/npaulat99/EmbedRisk.git"
  },
  "license": "GPL-3.0-only",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "threat-modeling",
    "risk-assessment",
    "security",
    "ics",
    "ot",
    "iec-62443"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "embedrisk.newProject",
        "title": "New Project",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.openWebapp",
        "title": "Open webapp in this folder",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.wizard",
        "title": "Open guided wizard",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.kbBrowse",
        "title": "Browse knowledge base (catalogue)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.kbImport",
        "title": "Import knowledge base (git)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.kbRemove",
        "title": "Remove imported knowledge base",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.dfdToDrawio",
        "title": "Open DFD in draw.io editor",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.dfdNative",
        "title": "Open DFD canvas (native)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.newAttackTree",
        "title": "New attack tree for a threat",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.useCases",
        "title": "Open use-case diagrams",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.dfdLayerDown",
        "title": "DFD layer down (into component)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.dfdLayerUp",
        "title": "DFD layer up (parent)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.report",
        "title": "Generate report",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.exportTraceabilityCsv",
        "title": "Export traceability (CSV)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.exportTraceabilityJson",
        "title": "Export traceability (JSON)",
        "category": "EmbedRisk"
      },
      {
        "command": "embedrisk.exportSbom",
        "title": "Export SBOM",
        "category": "EmbedRisk"
      }
    ],
    "keybindings": [
      {
        "command": "embedrisk.dfdLayerDown",
        "key": "ctrl+alt+down"
      },
      {
        "command": "embedrisk.dfdLayerUp",
        "key": "ctrl+alt+up"
      }
    ],
    "configuration": {
      "title": "EmbedRisk",
      "properties": {
        "embedrisk.project.riskScoringMethod": {
          "type": "string",
          "enum": [
            "cost-based",
            "exposure-exploitability-impact"
          ],
          "default": "cost-based",
          "scope": "resource",
          "description": "Project risk-scoring method."
        },
        "embedrisk.project.costFactorWeights": {
          "type": "object",
          "default": {
            "time": 0.25,
            "exploitability": 0.2,
            "window": 0.15,
            "detection": 0.15,
            "notoriety": 0.1,
            "prep": 0.1,
            "abort": 0.05
          },
          "scope": "resource",
          "description": "Project cost-factor weights. Values should total 1.00.",
          "properties": {
            "time": { "type": "number", "minimum": 0, "maximum": 1 },
            "exploitability": { "type": "number", "minimum": 0, "maximum": 1 },
            "window": { "type": "number", "minimum": 0, "maximum": 1 },
            "detection": { "type": "number", "minimum": 0, "maximum": 1 },
            "notoriety": { "type": "number", "minimum": 0, "maximum": 1 },
            "prep": { "type": "number", "minimum": 0, "maximum": 1 },
            "abort": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "embedrisk.project.accessProbabilities": {
          "type": "object",
          "default": {
            "1": 0.9,
            "2": 0.7,
            "3": 0.5,
            "4": 0.3,
            "5": 0.1
          },
          "scope": "resource",
          "description": "Project probability of obtaining each required access level.",
          "properties": {
            "1": { "type": "number", "minimum": 0.05, "maximum": 1 },
            "2": { "type": "number", "minimum": 0.05, "maximum": 1 },
            "3": { "type": "number", "minimum": 0.05, "maximum": 1 },
            "4": { "type": "number", "minimum": 0.05, "maximum": 1 },
            "5": { "type": "number", "minimum": 0.05, "maximum": 1 }
          }
        },
        "embedrisk.project.likelihoodProbabilityThresholds": {
          "type": "object",
          "default": {
            "2": 0.3,
            "3": 0.5,
            "4": 0.7,
            "5": 0.9
          },
          "scope": "resource",
          "description": "Lower probability bounds for likelihood levels L2 through L5.",
          "properties": {
            "2": { "type": "number", "minimum": 0.01, "maximum": 1 },
            "3": { "type": "number", "minimum": 0.01, "maximum": 1 },
            "4": { "type": "number", "minimum": 0.01, "maximum": 1 },
            "5": { "type": "number", "minimum": 0.01, "maximum": 1 }
          }
        },
        "embedrisk.project.acceptableRisk": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 25,
          "scope": "resource",
          "description": "Acceptable residual-risk threshold; warnings appear above this value."
        },
        "embedrisk.project.rigorousMode": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Require Bug Bar dimensions, exposure/exploitability, and a named rater on every threat."
        },
        "embedrisk.project.reportOptions.includeStrideBoundaryAnalysis": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Include STRIDE-per-trust-boundary tables in reports."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "embedrisk.dfdNative",
        "displayName": "EmbedRisk DFD canvas",
        "selector": [
          {
            "filenamePattern": "**/04-dfd/dfd.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "embedrisk.dfdEditor",
        "displayName": "EmbedRisk DFD (draw.io)",
        "selector": [
          {
            "filenamePattern": "**/04-dfd/dfd.json"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "embedrisk.attackTree",
        "displayName": "EmbedRisk attack trees",
        "selector": [
          {
            "filenamePattern": "**/07-attack-trees/attack-trees.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "embedrisk.useCases",
        "displayName": "EmbedRisk use-case diagrams",
        "selector": [
          {
            "filenamePattern": "**/04b-use-cases/use-cases.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --format=cjs",
    "lint": "npm run compile",
    "format:check": "npm run build",
    "compile": "tsc -p . --noEmit && npm run build",
    "watch": "npm run build -- --watch",
    "package": "npm run compile && vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies --pat $VSCE_PAT"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^4.1.2",
    "js-yaml": "4.3.1"
  }
}
